{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VS Code Extension Telemetry Event",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": { "type": "string", "minLength": 1 },
    "apiVersion": { "type": "integer", "const": 1 },
    "reqId": { "type": "string", "minLength": 1 },
    "ts": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1 },
    "phase": { "$ref": "#/definitions/rolloutPhase" },
    "schema": { "type": "string", "const": "vscode.telemetry.v1" },
    "event": { "$ref": "#/definitions/telemetryEventName" },
    "feature": { "$ref": "#/definitions/telemetryFeature" },
    "component": { "$ref": "#/definitions/telemetryComponent" },
    "kind": { "$ref": "#/definitions/telemetryKind" },
    "source": { "$ref": "#/definitions/telemetrySource" },
    "evaluation_ms": { "type": "number", "minimum": 0 },
    "attempt": { "type": "integer", "minimum": 0 },
    "maxAttempts": { "type": "integer", "minimum": 1 },
    "backoffMs": {
      "type": "array",
      "items": { "type": "number", "minimum": 0 }
    },
    "payload": { "type": "object" }
  },
  "required": [
    "type",
    "apiVersion",
    "reqId",
    "ts",
    "correlationId",
    "phase",
    "schema",
    "event",
    "feature",
    "component",
    "kind",
    "source",
    "evaluation_ms",
    "attempt",
    "maxAttempts",
    "backoffMs",
    "payload"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "event": { "const": "status.autosave" }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "state": {
                "type": "string",
                "enum": ["idle", "dirty", "saving", "saved"]
              },
              "debounce_ms": { "type": "number", "minimum": 0 },
              "latency_ms": { "type": "number", "minimum": 0 },
              "attempt": { "type": "integer", "minimum": 0 },
              "phase_step": { "$ref": "#/definitions/autoSavePhaseStep" },
              "guard": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "current": { "$ref": "#/definitions/rolloutPhase" },
                  "rollbackTo": { "$ref": "#/definitions/rolloutPhase" }
                },
                "required": ["current", "rollbackTo"]
              }
            },
            "required": [
              "state",
              "debounce_ms",
              "latency_ms",
              "attempt",
              "phase_step",
              "guard"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "const": "flag_resolution" }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "flag": { "type": "string", "minLength": 1 },
              "variant": { "type": "string", "minLength": 1 },
              "source": {
                "type": "string",
                "enum": ["env", "workspace", "localStorage", "default"]
              },
              "phase": {
                "$ref": "#/definitions/rolloutPhase",
                "enum": ["A-0", "A-1", "A-2", "B-0", "B-1"]
              },
              "evaluation_ms": { "type": "number", "minimum": 0 },
              "threshold": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "status": { "type": "string", "enum": ["success", "failure"] },
              "detail": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "retryable": { "type": "boolean" },
                  "default_used": { "type": "boolean" }
                },
                "required": ["retryable", "default_used"]
              },
              "errors": {
                "type": "array",
                "items": { "$ref": "#/definitions/flagValidationError" }
              }
            },
            "required": [
              "flag",
              "variant",
              "source",
              "phase",
              "evaluation_ms",
              "threshold",
              "status",
              "detail",
              "errors"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "const": "merge.trace" }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "phase": { "$ref": "#/definitions/mergeTracePhase" },
              "collisions": { "type": "integer", "minimum": 0 },
              "processing_ms": { "type": "number", "minimum": 0 },
              "guardrail": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "metric": { "$ref": "#/definitions/metricsKey" },
                  "observed": { "type": "number" },
                  "tolerance_pct": { "type": "number" },
                  "rollbackTo": { "$ref": "#/definitions/rolloutPhase" }
                },
                "required": [
                  "metric",
                  "observed",
                  "tolerance_pct",
                  "rollbackTo"
                ]
              },
              "digest": { "type": "string", "minLength": 1 }
            },
            "required": [
              "phase",
              "collisions",
              "processing_ms",
              "guardrail",
              "digest"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "const": "export.failed" }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "runId": { "type": "string", "minLength": 1 },
              "matchRate": { "type": "number" },
              "formats": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "error": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": { "type": "string", "minLength": 1 },
                  "message": { "type": "string", "minLength": 1 },
                  "retryable": { "type": "boolean" }
                },
                "required": ["code", "message", "retryable"]
              },
              "entries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "format": { "type": "string", "minLength": 1 },
                    "name": { "type": ["string", "null"], "minLength": 1 },
                    "status": {
                      "type": "string",
                      "enum": ["matched", "diff"]
                    },
                    "diff": { "type": ["string", "null"], "minLength": 1 }
                  },
                  "required": ["format", "status"]
                }
              },
              "next_backoff_ms": { "type": "number", "minimum": 0 }
            },
            "required": [
              "runId",
              "matchRate",
              "formats",
              "error",
              "entries",
              "next_backoff_ms"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "enum": [
            "plugins.invoked",
            "plugins.completed",
            "plugins.failed"
          ] }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pluginId": { "type": "string", "minLength": 1 },
              "action": { "type": "string", "minLength": 1 },
              "result": { "type": "string", "enum": ["success", "failure"] },
              "duration_ms": { "type": "number", "minimum": 0 },
              "sandboxViolation": { "type": "boolean", "const": true },
              "next_backoff_ms": { "type": "number", "minimum": 0 }
            },
            "required": [
              "pluginId",
              "action",
              "result",
              "duration_ms"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "const": "plugins.failed" }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sandboxViolation": { "type": "boolean", "const": true },
              "next_backoff_ms": { "type": "number", "minimum": 0 }
            },
            "required": [
              "pluginId",
              "action",
              "result",
              "duration_ms",
              "sandboxViolation",
              "next_backoff_ms"
            ]
          }
        }
      }
    }
  ],
  "definitions": {
    "rolloutPhase": {
      "type": "string",
      "enum": ["A-0", "A-1", "A-2", "B-0", "B-1"]
    },
    "telemetryEventName": {
      "type": "string",
      "enum": [
        "status.autosave",
        "flag_resolution",
        "merge.trace",
        "export.started",
        "export.success",
        "export.failed",
        "plugins.invoked",
        "plugins.completed",
        "plugins.failed"
      ]
    },
    "flagResolutionSource": {
      "type": "string",
      "enum": ["env", "workspace", "localStorage", "default"]
    },
    "mergeTracePhase": {
      "type": "string",
      "enum": ["queued", "applying", "completed"]
    },
    "metricsKey": {
      "type": "string",
      "enum": [
        "autosave_p95",
        "restore_success_rate",
        "merge_auto_success_rate"
      ]
    },
    "autoSavePhaseStep": {
      "type": "string",
      "enum": [
        "disabled",
        "debouncing",
        "awaiting-lock",
        "writing",
        "gc",
        "idle",
        "backoff",
        "error"
      ]
    },
    "flagValidationError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": ["invalid-boolean", "invalid-precision"]
        },
        "flag": { "type": "string", "minLength": 1 },
        "raw": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean", "const": false },
        "source": { "$ref": "#/definitions/flagResolutionSource" },
        "phase": {
          "type": "string",
          "enum": ["phase-a0", "phase-a1", "phase-a2", "phase-b0", "phase-b1"]
        }
      },
      "required": [
        "code",
        "flag",
        "raw",
        "message",
        "retryable",
        "source",
        "phase"
      ]
    },
    "telemetryFeature": {
      "type": "string",
      "enum": ["autosave-diff-merge", "config.flags"]
    },
    "telemetryComponent": {
      "type": "string",
      "enum": ["autosave", "merge", "flags", "export"]
    },
    "telemetryKind": {
      "type": "string",
      "enum": ["save", "ui", "merge", "flag_resolution", "export", "error"]
    },
    "telemetrySource": {
      "type": "string",
      "enum": ["app.autosave", "app.flags", "vscode.plugins"]
    }
  }
}
