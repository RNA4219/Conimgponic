{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VS Code Extension Telemetry Event",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": { "type": "string", "minLength": 1 },
    "apiVersion": { "type": "integer", "const": 1 },
    "reqId": { "type": "string", "minLength": 1 },
    "ts": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1 },
    "phase": { "$ref": "#/definitions/rolloutPhase" },
    "schema": { "type": "string", "const": "vscode.telemetry.v1" },
    "event": { "$ref": "#/definitions/telemetryEventName" },
    "retryCount": { "type": "integer", "minimum": 0 },
    "maxAttempts": { "type": "integer", "minimum": 1 },
    "backoffMs": {
      "type": "array",
      "items": { "type": "number", "minimum": 0 }
    },
    "payload": { "type": "object" }
  },
  "required": [
    "type",
    "apiVersion",
    "reqId",
    "ts",
    "correlationId",
    "phase",
    "schema",
    "event",
    "retryCount",
    "maxAttempts",
    "backoffMs",
    "payload"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "event": { "const": "status.autosave" }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "state": {
                "type": "string",
                "enum": ["idle", "dirty", "saving", "saved"]
              },
              "debounce_ms": { "type": "number", "minimum": 0 },
              "latency_ms": { "type": "number", "minimum": 0 },
              "retryCount": { "type": "integer", "minimum": 0 },
              "phase_step": { "$ref": "#/definitions/autoSavePhaseStep" },
              "guard": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "current": { "$ref": "#/definitions/rolloutPhase" },
                  "rollbackTo": { "$ref": "#/definitions/rolloutPhase" }
                },
                "required": ["current", "rollbackTo"]
              }
            },
            "required": [
              "state",
              "debounce_ms",
              "latency_ms",
              "retryCount",
              "phase_step",
              "guard"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "const": "flag_resolution" }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "flag": { "type": "string", "minLength": 1 },
              "variant": { "type": "string", "minLength": 1 },
              "source": {
                "type": "string",
                "enum": ["env", "workspace", "localStorage", "default"]
              },
              "phase": { "$ref": "#/definitions/rolloutPhase" },
              "evaluation_ms": { "type": "number", "minimum": 0 },
              "threshold": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
            },
            "required": [
              "flag",
              "variant",
              "source",
              "phase",
              "evaluation_ms",
              "threshold"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "const": "merge.trace" }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "phase": { "$ref": "#/definitions/mergeTracePhase" },
              "collisions": { "type": "integer", "minimum": 0 },
              "processing_ms": { "type": "number", "minimum": 0 },
              "guardrail": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "metric": { "$ref": "#/definitions/metricsKey" },
                  "observed": { "type": "number" },
                  "tolerance_pct": { "type": "number" },
                  "rollbackTo": { "$ref": "#/definitions/rolloutPhase" }
                },
                "required": [
                  "metric",
                  "observed",
                  "tolerance_pct",
                  "rollbackTo"
                ]
              },
              "digest": { "type": "string", "minLength": 1 }
            },
            "required": [
              "phase",
              "collisions",
              "processing_ms",
              "guardrail",
              "digest"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "enum": [
            "plugins.invoked",
            "plugins.completed",
            "plugins.failed"
          ] }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pluginId": { "type": "string", "minLength": 1 },
              "action": { "type": "string", "minLength": 1 },
              "result": { "type": "string", "enum": ["success", "failure"] },
              "duration_ms": { "type": "number", "minimum": 0 },
              "sandboxViolation": { "type": "boolean", "const": true }
            },
            "required": [
              "pluginId",
              "action",
              "result",
              "duration_ms"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "const": "plugins.failed" }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "pluginId",
              "action",
              "result",
              "duration_ms",
              "sandboxViolation"
            ]
          }
        }
      }
    }
  ],
  "definitions": {
    "rolloutPhase": {
      "type": "string",
      "enum": ["A-0", "A-1", "A-2", "B-0", "B-1"]
    },
    "telemetryEventName": {
      "type": "string",
      "enum": [
        "status.autosave",
        "flag_resolution",
        "merge.trace",
        "export.started",
        "export.success",
        "export.failed",
        "plugins.invoked",
        "plugins.completed",
        "plugins.failed"
      ]
    },
    "flagResolutionSource": {
      "type": "string",
      "enum": ["env", "workspace", "localStorage", "default"]
    },
    "mergeTracePhase": {
      "type": "string",
      "enum": ["queued", "applying", "completed"]
    },
    "metricsKey": {
      "type": "string",
      "enum": [
        "autosave_p95",
        "restore_success_rate",
        "merge_auto_success_rate"
      ]
    },
    "autoSavePhaseStep": {
      "type": "string",
      "enum": [
        "disabled",
        "debouncing",
        "awaiting-lock",
        "writing",
        "gc",
        "idle",
        "backoff",
        "error"
      ]
    }
  }
}
