{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VS Code Extension Telemetry Event",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": { "type": "string", "minLength": 1 },
    "apiVersion": { "type": "integer", "const": 1 },
    "reqId": {
      "type": "string",
      "minLength": 1,
      "format": "uuid",
      "description": "RFC4122 UUID issued by the Collector. Retries reuse the same value."
    },
    "ts": { "type": "string", "format": "date-time" },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "format": "uuid",
      "description": "RFC4122 UUID that matches reqId. Invalid overrides are normalized by the Collector."
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "format": "uuid",
      "description": "RFC4122 UUID identifying the VS Code workspace for aggregation."
    },
    "phase": { "$ref": "#/definitions/rolloutPhase" },
    "schema": { "type": "string", "const": "vscode.telemetry.v1" },
    "event": { "$ref": "#/definitions/telemetryEventName" },
    "feature": { "$ref": "#/definitions/telemetryFeature" },
    "component": { "$ref": "#/definitions/telemetryComponent" },
    "kind": { "$ref": "#/definitions/telemetryKind" },
    "source": { "$ref": "#/definitions/telemetrySource" },
    "evaluation_ms": { "type": "number", "minimum": 0 },
    "attempt": { "type": "integer", "minimum": 0 },
    "maxAttempts": { "type": "integer", "minimum": 1 },
    "backoffMs": {
      "type": "array",
      "items": { "type": "number", "minimum": 0 }
    },
    "payload": { "type": "object" }
  },
  "required": [
    "type",
    "apiVersion",
    "reqId",
    "ts",
    "correlationId",
    "workspace_id",
    "phase",
    "schema",
    "event",
    "feature",
    "component",
    "kind",
    "source",
    "evaluation_ms",
    "attempt",
    "maxAttempts",
    "backoffMs",
    "payload"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "event": { "const": "status.autosave" }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "state": {
                "type": "string",
                "enum": ["dirty", "saving", "saved", "backoff", "error", "disabled"]
              },
              "debounce_ms": { "type": "number", "minimum": 0 },
              "latency_ms": { "type": "number", "minimum": 0 },
              "attempt": { "type": "integer", "minimum": 0 },
              "phase_step": { "$ref": "#/definitions/autoSavePhaseStep" },
              "guard": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "current": { "$ref": "#/definitions/rolloutPhase" },
                  "rollbackTo": { "$ref": "#/definitions/rolloutPhase" }
                },
                "required": ["current", "rollbackTo"]
              },
              "detail": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "retry_count": { "type": "integer", "minimum": 0 }
                },
                "required": ["retry_count"]
              },
              "performance": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "flush_latency_ms": { "type": "number", "minimum": 0 }
                },
                "required": ["flush_latency_ms"]
              }
            },
            "required": [
              "state",
              "debounce_ms",
              "latency_ms",
              "attempt",
              "phase_step",
              "guard",
              "detail",
              "performance"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "const": "snapshot.result" }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "type": "string",
                "enum": ["success", "failure"]
              },
              "detail": { "$ref": "#/definitions/snapshotResultDetailBase" },
              "snapshot": { "$ref": "#/definitions/snapshotResultSnapshot" }
            },
            "required": ["status", "detail"],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": { "const": "success" }
                  }
                },
                "then": {
                  "required": ["snapshot"],
                  "properties": {
                    "detail": { "$ref": "#/definitions/snapshotResultSuccessDetail" }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": { "const": "failure" }
                  }
                },
                "then": {
                  "properties": {
                    "detail": { "$ref": "#/definitions/snapshotResultFailureDetail" },
                    "snapshot": { "$ref": "#/definitions/snapshotResultSnapshot" }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "const": "flag_resolution" }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "flag": { "type": "string", "minLength": 1 },
              "variant": { "type": "string", "minLength": 1 },
              "source": {
                "type": "string",
                "enum": ["env", "workspace", "localStorage", "default"]
              },
              "phase": {
                "$ref": "#/definitions/rolloutPhase",
                "enum": ["A-0", "A-1", "A-2", "B-0", "B-1"]
              },
              "evaluation_ms": { "type": "number", "minimum": 0 },
              "precision": {
                "type": ["string", "null"],
                "enum": ["legacy", "beta", "stable", null],
                "description": "Merge precision variant when available; null for non-merge flags."
              },
              "threshold": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "status": { "type": "string", "enum": ["success", "failure"] },
              "detail": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "retryable": { "type": "boolean" },
                  "default_used": { "type": "boolean" }
                },
                "required": ["retryable", "default_used"]
              },
              "errors": {
                "type": "array",
                "items": { "$ref": "#/definitions/flagValidationError" }
              }
            },
            "required": [
              "flag",
              "variant",
              "source",
              "phase",
              "evaluation_ms",
              "precision",
              "threshold",
              "status",
              "detail",
              "errors"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "const": "merge.result" }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "type": "string",
                "enum": ["success", "conflict", "error"]
              },
              "precision": {
                "type": "string",
                "enum": ["legacy", "beta", "stable"]
              },
              "processing_ms": { "type": "number", "minimum": 0 },
              "conflict_segments": { "type": "integer", "minimum": 0 },
              "error": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": { "type": "string", "minLength": 1 },
                  "message": { "type": "string", "minLength": 1 },
                  "retryable": { "type": "boolean" }
                },
                "required": ["code", "message", "retryable"]
              }
            },
            "required": [
              "status",
              "precision",
              "processing_ms",
              "conflict_segments"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": { "const": "success" }
                  }
                },
                "then": {
                  "properties": {
                    "conflict_segments": { "type": "integer", "const": 0 }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": { "const": "conflict" }
                  }
                },
                "then": {
                  "properties": {
                    "conflict_segments": { "type": "integer", "minimum": 1 }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": { "const": "error" }
                  }
                },
                "then": { "required": ["error"] }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "const": "merge.trace" }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "phase": { "$ref": "#/definitions/mergeTracePhase" },
              "collisions": { "type": "integer", "minimum": 0 },
              "processing_ms": { "type": "number", "minimum": 0 },
              "guardrail": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "metric": { "$ref": "#/definitions/metricsKey" },
                  "observed": { "type": "number" },
                  "tolerance_pct": { "type": "number" },
                  "rollbackTo": { "$ref": "#/definitions/rolloutPhase" }
                },
                "required": [
                  "metric",
                  "observed",
                  "tolerance_pct",
                  "rollbackTo"
                ]
              },
              "digest": { "type": "string", "minLength": 1 }
            },
            "required": [
              "phase",
              "collisions",
              "processing_ms",
              "guardrail",
              "digest"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "const": "export.result" }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "type": "string",
                "enum": ["success", "failure"]
              },
              "runId": { "type": "string", "minLength": 1 },
              "matchRate": { "type": "number" },
              "formats": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "duration_ms": { "type": "number", "minimum": 0 },
              "detail": { "$ref": "#/definitions/exportDetail" },
              "summary": { "$ref": "#/definitions/exportSummary" },
              "artifacts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "format": { "type": "string", "minLength": 1 },
                    "name": { "type": ["string", "null"], "minLength": 1 },
                    "status": {
                      "type": "string",
                      "enum": ["matched", "diff"]
                    },
                    "uri": { "type": ["string", "null"], "minLength": 1 },
                    "normalizedPath": {
                      "type": ["string", "null"],
                      "minLength": 1
                    },
                    "durationMs": { "type": ["number", "null"], "minimum": 0 },
                    "bytes": { "type": ["number", "null"], "minimum": 0 }
                  },
                  "required": [
                    "format",
                    "name",
                    "status",
                    "uri",
                    "normalizedPath",
                    "durationMs",
                    "bytes"
                  ]
                }
              },
              "error": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "properties": {
                  "code": { "type": "string", "minLength": 1 },
                  "message": { "type": "string", "minLength": 1 },
                  "retryable": { "type": "boolean" }
                },
                "required": ["code", "message", "retryable"]
              },
              "entries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "format": { "type": "string", "minLength": 1 },
                    "name": { "type": ["string", "null"], "minLength": 1 },
                    "status": {
                      "type": "string",
                      "enum": ["matched", "diff"]
                    },
                    "diff": { "type": ["string", "null"], "minLength": 1 }
                  },
                  "required": ["format", "status"]
                }
              },
              "next_backoff_ms": { "type": ["number", "null"], "minimum": 0 }
            },
            "required": [
              "status",
              "runId",
              "matchRate",
              "formats",
              "duration_ms",
              "detail",
              "summary",
              "artifacts"
            ],
            "allOf": [
              {
                "if": {
                  "properties": { "status": { "const": "success" } }
                },
                "then": {
                  "required": ["artifacts"],
                  "properties": {
                    "error": { "const": null },
                    "entries": { "type": "array" },
                    "next_backoff_ms": { "type": ["number", "null"], "minimum": 0 }
                  }
                }
              },
              {
                "if": {
                  "properties": { "status": { "const": "failure" } }
                },
                "then": {
                  "required": ["error", "entries", "next_backoff_ms"],
                  "properties": {
                    "error": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "code": { "type": "string", "minLength": 1 },
                        "message": { "type": "string", "minLength": 1 },
                        "retryable": { "type": "boolean" }
                      },
                      "required": ["code", "message", "retryable"]
                    },
                    "entries": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "format": { "type": "string", "minLength": 1 },
                          "name": { "type": ["string", "null"], "minLength": 1 },
                          "status": {
                            "type": "string",
                            "enum": ["matched", "diff"]
                          },
                          "diff": { "type": ["string", "null"], "minLength": 1 }
                        },
                        "required": ["format", "status"]
                      }
                    },
                    "next_backoff_ms": { "type": "number", "minimum": 0 }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "const": "error" }
        }
      },
      "then": {
        "properties": {
          "component": { "$ref": "#/definitions/telemetryComponent" },
          "kind": { "type": "string", "const": "error" },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "detail": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "error_code": { "type": "string", "minLength": 1 },
                  "retryable": { "type": "boolean" },
                  "message": { "type": "string", "minLength": 1 }
                },
                "required": ["error_code", "retryable"]
              },
              "tags": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "minItems": 1
              }
            },
            "required": ["detail", "tags"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "enum": [
            "plugins.invoked",
            "plugins.failed"
          ] }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pluginId": { "type": "string", "minLength": 1 },
              "action": { "type": "string", "minLength": 1 },
              "result": { "type": "string", "enum": ["success", "failure"] },
              "duration_ms": { "type": "number", "minimum": 0 },
              "sandboxViolation": { "type": "boolean", "const": true },
              "next_backoff_ms": { "type": "number", "minimum": 0 }
            },
            "required": [
              "pluginId",
              "action",
              "result",
              "duration_ms"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "const": "plugins.completed" }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pluginId": { "type": "string", "minLength": 1 },
              "action": { "type": "string", "minLength": 1 },
              "result": { "type": "string", "const": "success" },
              "duration_ms": { "type": "number", "minimum": 0 },
              "sandboxViolation": { "type": "boolean", "const": true },
              "next_backoff_ms": { "type": "number", "minimum": 0 }
            },
            "required": [
              "pluginId",
              "action",
              "result",
              "duration_ms"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": { "const": "plugins.failed" }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sandboxViolation": { "type": "boolean", "const": true },
              "next_backoff_ms": { "type": "number", "minimum": 0 }
            },
            "required": [
              "pluginId",
              "action",
              "result",
              "duration_ms",
              "sandboxViolation",
              "next_backoff_ms"
            ]
          }
        }
      }
    }
  ],
  "definitions": {
    "rolloutPhase": {
      "type": "string",
      "enum": ["A-0", "A-1", "A-2", "B-0", "B-1"]
    },
    "telemetryEventName": {
      "type": "string",
      "enum": [
        "status.autosave",
        "snapshot.result",
        "flag_resolution",
        "merge.result",
        "merge.trace",
        "export.result",
        "plugins.invoked",
        "plugins.completed",
        "plugins.failed",
        "error"
      ]
    },
    "exportDetail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration_ms": { "type": "number", "minimum": 0 }
      },
      "required": ["duration_ms"]
    },
    "exportSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "export_latency_p95": { "type": "number", "minimum": 0 },
        "export_success_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": ["export_latency_p95", "export_success_rate"]
    },
    "flagResolutionSource": {
      "type": "string",
      "enum": ["env", "workspace", "localStorage", "default"]
    },
    "mergeTracePhase": {
      "type": "string",
      "enum": ["queued", "applying", "completed"]
    },
    "metricsKey": {
      "type": "string",
      "enum": [
        "autosave_p95",
        "ui_saved_rate",
        "restore_success_rate",
        "merge_auto_success_rate",
        "merge_processing_p95",
        "export_latency_p95",
        "export_success_rate"
      ]
    },
    "autoSavePhaseStep": {
      "type": "string",
      "enum": [
        "disabled",
        "debouncing",
        "awaiting-lock",
        "writing",
        "gc",
        "idle",
        "backoff",
        "error"
      ]
    },
    "flagValidationError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": ["invalid-boolean", "invalid-precision"]
        },
        "flag": { "type": "string", "minLength": 1 },
        "raw": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean", "const": false },
        "source": { "$ref": "#/definitions/flagResolutionSource" },
        "phase": {
          "type": "string",
          "enum": ["phase-a0", "phase-a1", "phase-a2", "phase-b0", "phase-b1"]
        }
      },
      "required": [
        "code",
        "flag",
        "raw",
        "message",
        "retryable",
        "source",
        "phase"
      ]
    },
    "snapshotResultDetailBase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration_ms": { "type": "number", "minimum": 0 },
        "retry_count": { "type": "integer", "minimum": 0 },
        "retryable": { "type": "boolean" },
        "error_code": { "type": ["string", "null"], "minLength": 1 },
        "error_message": { "type": "string", "minLength": 1 },
        "lag_seconds": { "type": "number", "minimum": 0 }
      },
      "required": ["duration_ms", "retry_count", "retryable", "error_code"]
    },
    "snapshotResultSuccessDetail": {
      "allOf": [
        { "$ref": "#/definitions/snapshotResultDetailBase" },
        {
          "properties": {
            "error_code": { "type": "null" },
            "retryable": { "type": "boolean", "const": false }
          }
        }
      ]
    },
    "snapshotResultFailureDetail": {
      "allOf": [
        { "$ref": "#/definitions/snapshotResultDetailBase" },
        {
          "properties": {
            "error_code": { "type": "string", "minLength": 1 },
            "error_message": { "type": "string", "minLength": 1 }
          },
          "required": [
            "duration_ms",
            "retry_count",
            "retryable",
            "error_code",
            "error_message"
          ]
        }
      ]
    },
    "snapshotResultSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bytes": { "type": "integer", "minimum": 0 },
        "retained_bytes": { "type": "integer", "minimum": 0 },
        "generation": { "type": "integer", "minimum": 0 },
        "last_success_at": { "type": "string", "format": "date-time" }
      },
      "required": [
        "bytes",
        "retained_bytes",
        "generation",
        "last_success_at"
      ]
    },
    "telemetryFeature": {
      "type": "string",
      "enum": ["autosave-diff-merge", "config.flags"]
    },
    "telemetryComponent": {
      "type": "string",
      "enum": ["autosave", "merge", "flags", "export"]
    },
    "telemetryKind": {
      "type": "string",
      "enum": ["save", "ui", "merge", "flag_resolution", "export", "error"]
    },
    "telemetrySource": {
      "type": "string",
      "enum": ["app.autosave", "app.merge", "app.flags", "vscode.plugins"]
    },
    "telemetryEnvelopeMetadataField": {
      "type": "string",
      "enum": ["feature", "component", "kind", "source", "evaluation_ms"]
    }
  }
}
